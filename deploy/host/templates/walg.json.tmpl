{
  "WALG_S3_PREFIX": "s3://@BACKUP_BUCKET@/db",
  "AWS_ENDPOINT": "https://@OBJECT_STORAGE_CLUSTER@.linodeobjects.com",
  "AWS_REGION": "@OBJECT_STORAGE_CLUSTER@",
  "AWS_S3_FORCE_PATH_STYLE": "true",
  "AWS_ACCESS_KEY_ID": "@BACKUP_ACCESS_KEY_ID@",
  "AWS_SECRET_ACCESS_KEY": "@BACKUP_SECRET_ACCESS_KEY@",
  "WALG_LIBSODIUM_KEY": "@WALG_LIBSODIUM_KEY@",
  "WALG_LIBSODIUM_KEY_TRANSFORM": "hex",
  "WALG_COMPRESSION_METHOD": "lz4",
  "WALG_DELTA_MAX_STEPS": "0",
  "WALG_UPLOAD_CONCURRENCY": "2",
  "WALG_DOWNLOAD_CONCURRENCY": "2",
  "WALG_UPLOAD_DISK_CONCURRENCY": "1",
  "PGHOST": "/var/run/postgresql",
  "PGPORT": "@PG_PORT@",
  "PGUSER": "postgres",
  "PGDATA": "@PG_DATA@"
}

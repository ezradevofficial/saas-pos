{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.curaafrya.com",
        "EXPO_PUBLIC_SENTRY_ENVIRONMENT": "staging",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "environment": "preview"
    }
  }
}

{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true,
        "allowExportNames": [
          "formatAmount",
          "useTheme",
          "useAuth"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/components/ui/**",
        "src/routes.jsx"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}

APP_NAME="App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8008

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Two roles (ADR 002): DB_USERNAME is the runtime role, always subject to
# row-level security; DB_OWNER_* owns the schema and runs migrations
# (composer migrate). Create both with database/scripts/setup-local-db.sh.
# DB_CONNECTION must stay pgsql. Connect directly or through session pooling
# only: the tenant setting is session-level (no transaction pooling).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=app
DB_OWNER_USERNAME=app_owner
DB_OWNER_PASSWORD=app_owner
DB_SSLMODE=prefer

FRONTEND_URL=http://localhost:3008
# Origins allowed to call the API, comma-separated. Local only: the web app
# (3008) and the POS web preview (3009). Real environments list their own.
CORS_ALLOWED_ORIGINS=http://localhost:3008,http://localhost:3009

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Text messages. `log` only in local and testing; real environments need a
# provider (the API refuses to boot with log mail or SMS outside local/testing).
SMS_DRIVER=log

# NOT-01: push, SMS and WhatsApp notification providers. Empty: `fake` in
# local and testing (logged, never sent), the channel unavailable elsewhere;
# `none` switches a channel off. `fake` is refused outside local/testing.
NOTIFICATIONS_PUSH_DRIVER=
NOTIFICATIONS_SMS_DRIVER=
NOTIFICATIONS_WHATSAPP_DRIVER=

# CUR-03: reference-rate feed endpoints (empty: the feed is not configured).
RATE_FEED_CBK_URL=
RATE_FEED_BCC_URL=

# MD-02: item images. local (storage/app/media) or s3 (Linode Object
# Storage; needs league/flysystem-aws-s3-v3). See README, Media storage.
MEDIA_DISK_DRIVER=local
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
MEDIA_REGION=
MEDIA_ENDPOINT=
MEDIA_BUCKET=
MEDIA_USE_PATH_STYLE_ENDPOINT=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_NAME="App"
APP_ENV=local
APP_KEY=
# HR-10: key of employee identifier digests (separate from APP_KEY; required outside local and testing).
HR_DIGEST_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8008

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Two roles (ADR 002): DB_USERNAME is the runtime role, always subject to
# row-level security; DB_OWNER_* owns the schema and runs migrations
# (composer migrate). Create both with database/scripts/setup-local-db.sh.
# Only migrations and deploy commands use DB_OWNER_*: web requests, queue
# workers and the scheduler never do, so leave them out on worker hosts.
# DB_CONNECTION must stay pgsql. Connect directly or through session pooling
# only: the tenant setting is session-level (no transaction pooling).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=app
DB_OWNER_USERNAME=app_owner
DB_OWNER_PASSWORD=app_owner
# Phase 8 review L9: how long a migration waits for a table lock before it
# gives up (the deploy retries it; docs/deploy-linode.md). Empty to wait forever.
DB_OWNER_LOCK_TIMEOUT=5s
# ADR 013: the platform staff role (staff sign-in, tokens, audit, catalogue
# edits). It reaches only the platform and catalogue tables.
DB_PLATFORM_USERNAME=app_platform
DB_PLATFORM_PASSWORD=app_platform
# ADR 013: serve the platform console on its own subdomain in production
# (setup links point here); defaults to FRONTEND_URL.
PLATFORM_URL=
DB_SSLMODE=prefer

FRONTEND_URL=http://localhost:3008
# Origins allowed to call the API, comma-separated. Local only: the web app
# (3008) and the POS web preview (3009). Real environments list their own.
CORS_ALLOWED_ORIGINS=http://localhost:3008,http://localhost:3009

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
# Queues, each with its own Horizon supervisor (config/horizon.php):
# `default`, notifications (deliveries, digests, approval timers) and
# automation (rule runs, timed scans, webhooks). Run `php artisan horizon`.
NOTIFICATIONS_QUEUE=notifications
AUTOMATION_QUEUE=automation
# HORIZON_PREFIX=

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Text messages. `log` only in local and testing; real environments need a
# provider (the API refuses to boot with log mail or SMS outside local/testing).
SMS_DRIVER=log

# NOT-01: push, SMS and WhatsApp notification providers. Empty: `fake` in
# local and testing (logged, never sent), the channel unavailable elsewhere;
# `none` switches a channel off. `fake` is refused outside local/testing.
NOTIFICATIONS_PUSH_DRIVER=
NOTIFICATIONS_SMS_DRIVER=
NOTIFICATIONS_WHATSAPP_DRIVER=

# CUR-03: reference-rate feed endpoints (empty: the feed is not configured).
RATE_FEED_CBK_URL=
RATE_FEED_BCC_URL=

# NFR-07, TEN-01: tenant files (images, documents, imports, exports, proof
# photos, branding) go to Linode Object Storage as soon as AWS_BUCKET is set,
# else to storage/app/media (development). Required in production
# (app:preflight). MEDIA_DISK=media or s3 forces one; leave it unset.
# See docs/deploy-linode.md, Object Storage.
MEDIA_DISK=

# Linode Object Storage (S3-compatible). An access key limited to this
# environment's bucket, read/write. Never commit values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# The cluster's id, e.g. de-fra-1 (Frankfurt).
AWS_DEFAULT_REGION=
AWS_BUCKET=
# The cluster endpoint, e.g. https://de-fra-1.linodeobjects.com
AWS_ENDPOINT=
# false (virtual-hosted style, Linode's default); true only for a bucket name with dots.
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Load balancer backend range allowed to report the client address (Linode NodeBalancer: 192.168.255.0/24).
# `none` when reached directly on purpose; empty warns outside local and testing.
TRUSTED_PROXIES=

# ADR 025: true once the host's backups are on (deploy/host, docs/backups.md);
# app:preflight warns in production while false.
BACKUPS_ENABLED=false
# ADR 025: `single-host` on the 1 vCPU starting host (fewer Horizon workers,
# api/config/horizon.php); empty elsewhere.
HORIZON_PROFILE=

# BR-04..BR-06: tenant subdomains ({slug}.APP_BASE_DOMAIN), custom domains
# (DNS TXT verification, Caddy on-demand TLS ask) and the email sender
# guidance. See docs/integrations.md, Branding.
APP_BASE_DOMAIN=
BRANDING_CNAME_TARGET=
BRANDING_TXT_PREFIX=_platform-verify
BRANDING_TXT_VALUE_PREFIX=platform-verify=
BRANDING_DOMAIN_PENDING_DAYS=3
BRANDING_PUBLIC_PER_MINUTE=60
BRANDING_SPF_INCLUDE=
BRANDING_DKIM_SELECTOR=
BRANDING_DKIM_TARGET=

  "values": [
    {
      "name": "api_key",
      "pattern": "\\bsk_(live|test)_[a-z0-9]{16}_[A-Za-z0-9]{40}",
      "flags": "",
      "replace": "[token]"
    },
    {
      "name": "webhook_secret",
      "pattern": "whsec_[A-Za-z0-9+/=]{20,}",
      "flags": "",
      "replace": "[token]"
    },
    {
      "name": "support_entry_code",
      "pattern": "\\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\\.[A-Za-z0-9]{48}\\b",
      "flags": "",
      "replace": "[token]"
    },
    {
      "name": "bearer",
      "pattern": "\\b(Bearer|Basic)\\s+[A-Za-z0-9._~+/=|-]{8,}",
      "flags": "i",
      "replace": "$1 [redacted]"
    },
    {
      "name": "jwt",
      "pattern": "\\beyJ[A-Za-z0-9_-]{5,}\\.[A-Za-z0-9_-]{5,}\\.[A-Za-z0-9_-]{5,}",
      "flags": "",
      "replace": "[token]"
    },
    {
      "name": "sanctum_token",
      "pattern": "\\b\\d+\\|[A-Za-z0-9]{20,}",
      "flags": "",
      "replace": "[token]"
    },
    {
      "name": "path_token",
      "pattern": "/(?![0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}(?:[/?#\\s\"']|$))[A-Za-z0-9_-]{32,}(?=[/?#\\s\"']|$)",
      "flags": "",
      "replace": "/[redacted]"
    },
    {
      "name": "query_secret",
      "pattern": "((?:[?&#\\s]|^)(?:\\w*_)?(?:token|access_token|signature|key|api_key|code|password|secret|pin|otp|verifier|ticket|state|samlresponse|samlrequest|relaystate)=)[^&#\\s\"']+",
      "flags": "i",
      "replace": "$1[redacted]"
    },
    {
      "name": "email",
      "pattern": "[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}",
      "flags": "i",
      "replace": "[email]"
    },
    {
      "name": "card_number",
      "pattern": "(?<![\\w-])(?:\\d[ -]?){12,18}\\d(?![\\w-])",
      "flags": "",
      "replace": "[number]"
    },
    {
      "name": "phone_international",
      "pattern": "(?:\\+|\\b00)(?:\\d[ -]?){7,14}\\d\\b",
      "flags": "",
      "replace": "[phone]"
    },
    {
      "name": "phone_local",
      "pattern": "\\b0[1789]\\d{2}[ -]?\\d{3}[ -]?\\d{3}\\b",
      "flags": "",
      "replace": "[phone]"
    },
    {
      "name": "country_phone",
      "pattern": "\\b(?:254|243)\\d{9}\\b",
      "flags": "",
      "replace": "[phone]"
    },
    {
      "name": "high_entropy",
      "pattern": "\\b(?=[A-Za-z0-9]*[A-Z])(?=[A-Za-z0-9]*[a-z])(?=[A-Za-z0-9]*[0-9])[A-Za-z0-9]{32,}\\b",
      "flags": "",
      "replace": "[token]"
    }
  ],

      ],
      "promotions": [{ "id": "p1", "version": 1, "type": "buy_x_get_y", "buy_qty": 1, "get_qty": 1, "percent": "50" }],
      "expected": {
        "lines": [{ "line_id": "l2", "promotion_id": "p1", "version": 1, "discount_minor": "250" }],

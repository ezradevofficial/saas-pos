    {
      "name": "buy 2 of one item, get 1 of another free",
      "lines": [
        { "id": "l1", "item_id": "i1", "category_ids": [], "qty": "3", "unit_price_minor": "1000" },
        { "id": "l2", "item_id": "i2", "category_ids": [], "qty": "2", "unit_price_minor": "600" }
      ],
      "promotions": [{ "id": "p1", "version": 1, "type": "buy_x_get_y", "buy_qty": 2, "get_qty": 1, "percent": "100", "targets": { "items": ["i1"], "categories": [] }, "get_targets": { "items": ["i2"], "categories": [] } }],
      "expected": {
        "lines": [{ "line_id": "l2", "promotion_id": "p1", "version": 1, "discount_minor": "600" }],

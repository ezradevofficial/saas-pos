      "lines": [
        { "id": "l1", "item_id": "i1", "category_ids": [], "qty": "1", "unit_price_minor": "1000" },
        { "id": "l2", "item_id": "i2", "category_ids": [], "qty": "1", "unit_price_minor": "800" }
      ],
      "promotions": [{ "id": "p1", "version": 1, "type": "bundle", "currency": "KES", "amount_minor": "2000", "components": [{ "item_id": "i1", "qty": 1 }, { "item_id": "i2", "qty": 1 }] }],
      "expected": { "lines": [], "promotions": [], "total_discount_minor": "0" }
    },
    {
      "name": "happy hour inside its window on a weekday",

{
  "about": "LOY-10: promotion engine cases shared by api/modules/Loyalty/tests/PromotionEngineFixturesTest.php and pos/src/loyalty/engine.test.js. Amounts are minor units (strings), quantities decimal strings, percentages decimal strings. A promotion lists only the fields that differ from the engine's defaults (no targets: every item; no conditions; no coupon). `context.local` is the sale's time in the branch's time zone (weekday 1 = Monday).",
  "context": { "currency": "KES", "branch_id": "b1", "customer_tags": [], "coupons": [], "local": { "date": "2026-10-13", "weekday": 2, "time": "12:00" } },
  "cases": [
    {
      "name": "percent off every item, half up per line",
      "lines": [
        { "id": "l1", "item_id": "i1", "category_ids": ["c1"], "qty": "2", "unit_price_minor": "50000" },
        { "id": "l2", "item_id": "i2", "category_ids": [], "qty": "1", "unit_price_minor": "33333" }
      ],
      "promotions": [{ "id": "p1", "version": 3, "type": "percent", "percent": "10" }],
      "expected": {
        "lines": [
          { "line_id": "l1", "promotion_id": "p1", "version": 3, "discount_minor": "10000" },
          { "line_id": "l2", "promotion_id": "p1", "version": 3, "discount_minor": "3333" }
        ],
        "promotions": [{ "promotion_id": "p1", "version": 3, "discount_minor": "13333", "coupon": null }],
        "total_discount_minor": "13333"
      }
    },
    {
      "name": "percent on a weighed line: gross and discount each rounded half up once",
      "lines": [{ "id": "l1", "item_id": "i1", "category_ids": [], "qty": "1.5", "unit_price_minor": "333" }],
      "promotions": [{ "id": "p1", "version": 1, "type": "percent", "percent": "12.5" }],
      "expected": {
        "lines": [{ "line_id": "l1", "promotion_id": "p1", "version": 1, "discount_minor": "63" }],
        "promotions": [{ "promotion_id": "p1", "version": 1, "discount_minor": "63", "coupon": null }],
        "total_discount_minor": "63"
      }
    },
    {
      "name": "amount off shared by largest remainder, earlier line first on a tie",
      "lines": [
        { "id": "l1", "item_id": "i1", "category_ids": [], "qty": "1", "unit_price_minor": "1000" },
        { "id": "l2", "item_id": "i2", "category_ids": [], "qty": "1", "unit_price_minor": "1000" },
        { "id": "l3", "item_id": "i3", "category_ids": [], "qty": "1", "unit_price_minor": "1000" }
      ],
      "promotions": [{ "id": "p1", "version": 1, "type": "amount_off", "currency": "KES", "amount_minor": "100" }],
      "expected": {
        "lines": [
          { "line_id": "l1", "promotion_id": "p1", "version": 1, "discount_minor": "34" },
          { "line_id": "l2", "promotion_id": "p1", "version": 1, "discount_minor": "33" },
          { "line_id": "l3", "promotion_id": "p1", "version": 1, "discount_minor": "33" }
        ],
        "promotions": [{ "promotion_id": "p1", "version": 1, "discount_minor": "100", "coupon": null }],
        "total_discount_minor": "100"
      }
    },
    {
      "name": "amount off never exceeds the eligible subtotal",
      "lines": [
        { "id": "l1", "item_id": "i1", "category_ids": [], "qty": "1", "unit_price_minor": "10000" },
        { "id": "l2", "item_id": "i2", "category_ids": [], "qty": "1", "unit_price_minor": "5000" }
      ],
      "promotions": [{ "id": "p1", "version": 1, "type": "amount_off", "currency": "KES", "amount_minor": "20000" }],
      "expected": {
        "lines": [
          { "line_id": "l1", "promotion_id": "p1", "version": 1, "discount_minor": "10000" },
          { "line_id": "l2", "promotion_id": "p1", "version": 1, "discount_minor": "5000" }
        ],
        "promotions": [{ "promotion_id": "p1", "version": 1, "discount_minor": "15000", "coupon": null }],
        "total_discount_minor": "15000"
      }
    },
    {
      "name": "minimum spend not reached: nothing applies",
      "lines": [{ "id": "l1", "item_id": "i1", "category_ids": [], "qty": "3", "unit_price_minor": "5000" }],
      "promotions": [{ "id": "p1", "version": 1, "type": "amount_off", "currency": "KES", "amount_minor": "5000", "min_spend_minor": "20000" }],
      "expected": { "lines": [], "promotions": [], "total_discount_minor": "0" }
    },
    {
      "name": "a promotion with an amount applies only in its currency; a percent applies in any",
      "lines": [{ "id": "l1", "item_id": "i1", "category_ids": [], "qty": "1", "unit_price_minor": "10000" }],
      "promotions": [
        { "id": "p1", "version": 1, "type": "amount_off", "priority": 9, "currency": "USD", "amount_minor": "500" },
        { "id": "p2", "version": 1, "type": "percent", "percent": "5" }
      ],
      "expected": {
        "lines": [{ "line_id": "l1", "promotion_id": "p2", "version": 1, "discount_minor": "500" }],
        "promotions": [{ "promotion_id": "p2", "version": 1, "discount_minor": "500", "coupon": null }],
        "total_discount_minor": "500"
      }
    },
    {
      "name": "higher priority first; a line gets one promotion; equal priority by id",
      "lines": [
        { "id": "l1", "item_id": "i1", "category_ids": [], "qty": "1", "unit_price_minor": "10000" },
        { "id": "l2", "item_id": "i2", "category_ids": [], "qty": "1", "unit_price_minor": "10000" },
        { "id": "l3", "item_id": "i3", "category_ids": [], "qty": "1", "unit_price_minor": "10000" }
      ],
      "promotions": [
        { "id": "p9", "version": 1, "type": "percent", "priority": 1, "percent": "10" },
        { "id": "p2", "version": 1, "type": "percent", "priority": 5, "percent": "20", "targets": { "items": ["i1"], "categories": [] } },
        { "id": "p1", "version": 2, "type": "percent", "priority": 5, "percent": "30", "targets": { "items": ["i2"], "categories": [] } }
      ],
      "expected": {
        "lines": [
          { "line_id": "l1", "promotion_id": "p2", "version": 1, "discount_minor": "2000" },
          { "line_id": "l2", "promotion_id": "p1", "version": 2, "discount_minor": "3000" },
          { "line_id": "l3", "promotion_id": "p9", "version": 1, "discount_minor": "1000" }
        ],
        "promotions": [
          { "promotion_id": "p1", "version": 2, "discount_minor": "3000", "coupon": null },
          { "promotion_id": "p2", "version": 1, "discount_minor": "2000", "coupon": null },
          { "promotion_id": "p9", "version": 1, "discount_minor": "1000", "coupon": null }
        ],
        "total_discount_minor": "6000"
      }
    },
    {
      "name": "category targets match any of the line's categories",
      "lines": [
        { "id": "l1", "item_id": "i1", "category_ids": ["c1"], "qty": "1", "unit_price_minor": "4000" },
        { "id": "l2", "item_id": "i2", "category_ids": ["c9", "c2"], "qty": "1", "unit_price_minor": "4000" }
      ],
      "promotions": [{ "id": "p1", "version": 1, "type": "percent", "percent": "50", "targets": { "items": [], "categories": ["c2"] } }],
      "expected": {
        "lines": [{ "line_id": "l2", "promotion_id": "p1", "version": 1, "discount_minor": "2000" }],
        "promotions": [{ "promotion_id": "p1", "version": 1, "discount_minor": "2000", "coupon": null }],
        "total_discount_minor": "2000"
      }
    },
    {
      "name": "buy 2 get 1 free in one set: whole units only, the cheapest unit is free",

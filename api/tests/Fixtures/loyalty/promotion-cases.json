        "total_discount_minor": "600"
      }
    },
    {
      "name": "bundle: as many bundles as complete, discount shared by largest remainder",
      "lines": [
        { "id": "l1", "item_id": "i1", "category_ids": [], "qty": "3", "unit_price_minor": "1000" },
        { "id": "l2", "item_id": "i2", "category_ids": [], "qty": "4", "unit_price_minor": "800" }
      ],
      "promotions": [{ "id": "p1", "version": 1, "type": "bundle", "currency": "KES", "amount_minor": "2500", "components": [{ "item_id": "i1", "qty": 1 }, { "item_id": "i2", "qty": 2 }] }],
      "expected": {

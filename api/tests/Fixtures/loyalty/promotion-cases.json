        { "id": "l1", "item_id": "i1", "category_ids": [], "qty": "2", "unit_price_minor": "1000" },
        { "id": "l2", "item_id": "i1", "category_ids": [], "qty": "1", "unit_price_minor": "800" },
        { "id": "l3", "item_id": "i1", "category_ids": [], "qty": "1.5", "unit_price_minor": "1200" }
      ],
      "promotions": [{ "id": "p1", "version": 1, "type": "buy_x_get_y", "buy_qty": 2, "get_qty": 1, "percent": "100", "targets": { "items": ["i1"], "categories": [] } }],
      "expected": {
        "lines": [{ "line_id": "l2", "promotion_id": "p1", "version": 1, "discount_minor": "800" }],
        "promotions": [{ "promotion_id": "p1", "version": 1, "discount_minor": "800", "coupon": null }],
        "total_discount_minor": "800"
      }
    },
    {
      "name": "buy 1 get 1 half price: equal prices, the later line's unit is discounted",
      "lines": [
        { "id": "l1", "item_id": "i1", "category_ids": [], "qty": "2", "unit_price_minor": "500" },

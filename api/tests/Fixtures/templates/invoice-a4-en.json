{
    "description": "An A4 invoice with a two-column header row, a full lines table with headings, totals with tax lines, terms and a fiscal block for a company that does not transmit yet (off).",
    "type": "sales.invoice",
    "fiscal_required": true,
    "template": {
        "paper": "A4",
        "margins": {"top": 15, "right": 15, "bottom": 15, "left": 15},
        "language": "en",
        "blocks": [
            {"id": "head", "type": "row", "columns": [
                [
                    {"id": "logo", "type": "logo", "align": "left", "height": 15},
                    {"id": "company", "type": "text", "text": "{{company.legal_name}}", "size": "large", "weight": "medium"},
                    {"id": "company-address", "type": "field", "field": "company.address", "label": false}
                ],
                [
                    {"id": "number", "type": "field", "field": "document.number", "label": true},
                    {"id": "date", "type": "field", "field": "document.date", "label": true},
                    {"id": "due", "type": "field", "field": "document.due_date", "label": true}
                ]
            ]},
            {"id": "customer", "type": "field", "field": "customer.name", "label": true},
            {"id": "lines", "type": "lines", "columns": ["item_name", "qty", "unit_price", "discount", "tax", "total"]},
            {"id": "totals", "type": "totals", "show": ["subtotal", "discount", "tax", "total"]},
            {"id": "terms", "type": "terms", "text": "Payment within 30 days to {{company.name}}."},
            {"id": "fiscal", "type": "fiscal"}
        ]
    },
